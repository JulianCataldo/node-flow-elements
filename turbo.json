{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "clean": {
      "outputs": ["dist/**", "dist-site/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-site/**"]
    },
    "lint": {
      "cache": false
    },
    "wea:generate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:types": {},
    "test:unit": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    }
  }
}
