{
  "name": "@node-flow-elements/core",
  "version": "0.1.0-next.1",
  "repository": {
    "url": "https://github.com/JulianCataldo/node-flow-elements",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./flow": "./dist/flow.js",
    "./node": "./dist/node.js",
    "./port": "./dist/port.js",
    "./events": "./dist/events.js",
    "./types": "./dist/types.js",
    "./flow.el": "./dist/flow.el.js",
    "./links.el": "./dist/links.el.js",
    "./background.el": "./dist/background.el.js",
    "./handle.el": "./dist/handle.el.js",
    "./node.el": "./dist/node.el.js",
    "./port.el": "./dist/port.el.js",
    "./web-elements": "./dist/_ambient/web-elements.d.ts",
    "./types/react": "./types/react.d.ts",
    "./types/vue": "./types/vue.d.ts"
  },
  "files": [
    "dist/",
    "!dist/test",
    "test-d/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node --run copy:css && node --run copy:dts",
    "copy:css": "cd ./src && find . -name '*.css' ! -path './themes/webawesome/*' | cpio -pdm ../dist/",
    "copy:dts": "cd src && find . -name '*.d.ts' | cpio -pdm ../dist/",
    "dev": "tsc -w -p tsconfig.json",
    "postinstall": "ts-patch install -s",
    "test:e2e": "playwright test -c ../../playwright.config.ts",
    "test:e2e:dev": "playwright test -c ../../playwright.config.ts --ui",
    "test:e2e:headed": "playwright test -c ../../playwright.config.ts --headed",
    "test:types": "tsd -t test-d/index.test-entry.ts -f 'test-d/**/*.test-d.ts'",
    "test:unit": "c8 --reporter=html node --test 'dist/test/**/*.test.js'",
    "wea:generate": "wea-generate"
  },
  "dependencies": {
    "@lit-labs/motion": "^1.1.0",
    "@lit-labs/signals": "catalog:",
    "@lit/context": "^1.1.6",
    "clsx": "^2.1.1",
    "lit": "^3.3.2",
    "panzoom": "^9.4.4",
    "signal-polyfill": "0.2.2",
    "signal-utils": "0.21.1",
    "style-observer": "^0.1.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "jsx-forge": "0.4.0-next.1",
    "ts-patch": "^3.3.0",
    "tsd": "^0.33.0",
    "web-elements-analyzer": "0.0.0"
  },
  "peerDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@standard-schema/spec": "^1.1.0",
    "arktype": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@dagrejs/dagre": {
      "optional": true
    },
    "@standard-schema/spec": {
      "optional": true
    },
    "arktype": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "customElements": "custom-elements.json",
  "tsd": {
    "compilerOptions": {
      "baseUrl": "../..",
      "jsx": "react-native",
      "jsxImportSource": "jsx-forge",
      "skipLibCheck": true,
      "strict": true,
      "target": "ES2022",
      "module": "preserve",
      "moduleResolution": "bundler",
      "paths": {
        "jsx-forge/jsx-runtime": [
          "packages/core/test-d/shims/jsx-forge-jsx-runtime.d.ts"
        ]
      },
      "types": [
        "node",
        "packages/core/src/_ambient/css-modules.d.ts",
        "packages/core/src/_ambient/web-elements.d.ts"
      ],
      "lib": [
        "ES2022",
        "DOM",
        "DOM.Iterable"
      ]
    }
  }
}
